# ── Hindsight ───────────────────────────────────────────────────────────────
HINDSIGHT_MODE=local                           # local | cloud | offline
HINDSIGHT_LOCAL_URL=http://localhost:8888
HINDSIGHT_CLOUD_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=                             # only needed for cloud
HINDSIGHT_BANK_ID=ledgermind-ap-exceptions

# ── Budget caps (enforced in cloud mode only) ────────────────────────────────
BUDGET_MAX_RETAIN=500
BUDGET_MAX_REFLECT=100
BUDGET_MAX_RECALL=2000
BUDGET_MAX_TOKENS=480000

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=                                  # required
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_RETRIES=3

# ── App ───────────────────────────────────────────────────────────────────────
MEMORY_MODE=hindsight                          # hindsight | offline
LOG_LEVEL=INFO

